#!/usr/bin/env bash
#MISE description="push secrets from fnox → current repo's GitHub Actions secrets. Set FNOX_SYNC_KEYS=A,B,C in repo mise.toml [env]."
set -euo pipefail

unset FNOX_AGE_KEY

DRY_RUN="${1:-}"

# Parse the git origin URL rather than asking gh — `gh repo view` on a
# forked repo returns the *parent* repo (e.g. louistrue/ifc-lite when you
# really want joeblew999/ifc-lite). git remote points at where pushes go,
# which is what we want for secret sync.
ORIGIN_URL=$(git remote get-url origin 2>/dev/null || true)
if [ -z "$ORIGIN_URL" ]; then
  echo "✗ no git origin remote — run from inside a git repo with a GitHub origin" >&2
  exit 1
fi
REPO=$(printf '%s' "$ORIGIN_URL" | sed -E 's|.*[:/]([^/]+)/([^/.]+)(\.git)?$|\1/\2|')
if ! printf '%s' "$REPO" | grep -qE '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'; then
  echo "✗ couldn't parse owner/repo from origin URL: $ORIGIN_URL" >&2
  exit 1
fi
KEYS="${FNOX_SYNC_KEYS:-}"

if [ -z "$KEYS" ]; then
  echo "✗ FNOX_SYNC_KEYS not set." >&2
  echo "  Set it in your repo's mise.toml [env]:" >&2
  echo "    FNOX_SYNC_KEYS = \"CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID,...\"" >&2
  exit 1
fi

IFS=',' read -ra KEY_ARR <<< "$KEYS"
KEY_COUNT=$(echo "$KEYS" | tr ',' '\n' | wc -l | tr -d ' ')
echo "Syncing $KEY_COUNT secrets from fnox → $REPO..."
[ "$DRY_RUN" = "--dry-run" ] && echo "  (dry-run mode — nothing will be pushed)"

ok=0; skipped=0; failed=0
for KEY in "${KEY_ARR[@]}"; do
  KEY=$(echo "$KEY" | xargs)
  [ -z "$KEY" ] && continue
  if ! VALUE=$(fnox get "$KEY" 2>/dev/null); then
    echo "  ⤬ $KEY not in fnox (skipping)"
    skipped=$((skipped + 1))
    continue
  fi
  if [ -z "$VALUE" ]; then
    echo "  ⤬ $KEY empty in fnox (skipping)"
    skipped=$((skipped + 1))
    continue
  fi
  if [ "$DRY_RUN" = "--dry-run" ]; then
    VLEN=$(printf '%s' "$VALUE" | wc -c | tr -d ' ')
    echo "  ✓ $KEY (would set $VLEN bytes)"
    ok=$((ok + 1))
  else
    if printf '%s' "$VALUE" | gh secret set "$KEY" --repo "$REPO" 2>/dev/null; then
      echo "  ✓ $KEY → $REPO"
      ok=$((ok + 1))
    else
      echo "  ✗ $KEY failed to set"
      failed=$((failed + 1))
    fi
  fi
done

echo
echo "Done. ok=$ok skipped=$skipped failed=$failed"
[ "$failed" -eq 0 ]
