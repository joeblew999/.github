#!/usr/bin/env bash
#MISE description="Provision Cloudflare D1 + R2 for the active env. Reads METADATA_DB_NAME, BACKUP_BUCKET_NAME from config/<env>.env. Either may be empty (skipped). Writes new METADATA_DB_ID back. Idempotent. Skips create when name already present."
set -euo pipefail
unset FNOX_AGE_KEY

file=$(mise run -q env:resolve)
set -a; . "$file"; set +a

# Force-populate CLOUDFLARE_API_TOKEN so wrangler doesn't fall back to OAuth.
export CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-$(fnox get CLOUDFLARE_API_TOKEN 2>/dev/null || true)}"

# ── R2 bucket — idempotent via list ──────────────────────────────────────────
if [ -z "${BACKUP_BUCKET_NAME:-}" ]; then
  echo "↷ R2: BACKUP_BUCKET_NAME not set — skipped"
elif wrangler r2 bucket list 2>/dev/null | grep -qE "(^|\\s)$BACKUP_BUCKET_NAME(\\s|$)"; then
  echo "✓ R2 bucket '$BACKUP_BUCKET_NAME' already exists"
else
  echo "Creating R2 bucket '$BACKUP_BUCKET_NAME' ..."
  wrangler r2 bucket create "$BACKUP_BUCKET_NAME"
fi

# ── Metadata D1 — idempotent via env ID ──────────────────────────────────────
if [ -z "${METADATA_DB_NAME:-}" ]; then
  echo "↷ D1: METADATA_DB_NAME not set — skipped"
elif [ -n "${METADATA_DB_ID:-}" ]; then
  echo "✓ Metadata D1 id already set ($METADATA_DB_ID); skipping create."
else
  echo "Creating D1 database '$METADATA_DB_NAME' ..."
  out=$(wrangler d1 create "$METADATA_DB_NAME")
  # wrangler 4.84+ JSON-style "database_id": "<uuid>"; older = TOML database_id = "<uuid>"
  id=$(echo "$out" | grep -oE '"database_id"\s*:\s*"[^"]+"|database_id\s*=\s*"[^"]+"' | head -1 | sed -E 's/.*"([0-9a-f-]{36})".*/\1/')
  if [ -z "$id" ]; then
    echo "ERROR: could not parse database_id from output:" >&2
    echo "$out" >&2
    exit 1
  fi
  sed -i.bak -E "s|^METADATA_DB_ID=.*|METADATA_DB_ID=$id|" "$file"
  rm -f "$file.bak"
  echo "✓ Created D1 '$METADATA_DB_NAME' (id $id) and wrote to $file"
fi

# ── Schema apply — idempotent (wrangler skips already-applied) ───────────────
if [ -n "${METADATA_DB_NAME:-}" ] && [ -f "worker/schema.sql" ]; then
  echo "Applying worker/schema.sql to '$METADATA_DB_NAME' ..."
  wrangler d1 execute "$METADATA_DB_NAME" --remote --file=worker/schema.sql || true
fi

echo "Done. Next: fnox CLOUDFLARE_API_TOKEN/ACCOUNT_ID set; mise run cf:access-setup"
