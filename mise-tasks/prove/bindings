#!/usr/bin/env nu
#MISE description="Confirm the deployed Worker's bindings via wrangler --dry-run (no upload). Catches drift between wrangler.toml.template and the resources actually created."

def main [] {
  print "→ wrangler deploy --dry-run"
  let raw = (^wrangler deploy --dry-run --outdir build/dryrun | complete | get stdout)
  $raw
  | lines
  | where { |l| ($l =~ '^Binding') or ($l =~ '^Total Upload') or ($l =~ 'env\.') or ($l =~ '^\s+env\.') }
  | first 20
  | str join "\n"
  | print
}
