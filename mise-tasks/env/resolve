#!/usr/bin/env nu
#MISE description="resolve which config/<env>.env file to read; default `production`. Prints path. Hidden helper used by other shared tasks."
#MISE hide=true

def main [] {
  let env_name = ($env.MISE_ENV? | default ($env.ENV? | default "production"))
  let file = $"config/($env_name).env"
  if not ($file | path exists) {
    print --stderr $"ERROR: ($file) not found."
    print --stderr $"       cp config/template.env ($file)  and fill it in."
    exit 1
  }
  print -n $file
}
