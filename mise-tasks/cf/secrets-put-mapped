#!/usr/bin/env bash
#MISE description="Push 4 CF Access + auth secrets from fnox to the deployed Worker, mapping canonical fnox names -> Worker env names. Reads APP_POLICY_AUD_FNOX_KEY from config/<env>.env (e.g. D1_MANAGER_POLICY_AUD). Depends on wrangler.toml existing — run wrangler:gen first if needed."
set -euo pipefail
unset FNOX_AGE_KEY

file=$(mise run -q env:resolve)
set -a; . "$file"; set +a

: "${APP_POLICY_AUD_FNOX_KEY:?APP_POLICY_AUD_FNOX_KEY not set in $file}"

# Pairs of "<fnox-key>:<worker-secret-name>". The first three fnox keys are
# operator-shared canonical names; the fourth is per-app and read from
# APP_POLICY_AUD_FNOX_KEY in config/<env>.env.
declare -a pairs=(
  "CLOUDFLARE_ACCOUNT_ID:ACCOUNT_ID"
  "CLOUDFLARE_API_TOKEN:API_KEY"
  "CF_ACCESS_TEAM_DOMAIN:TEAM_DOMAIN"
  "${APP_POLICY_AUD_FNOX_KEY}:POLICY_AUD"
)

for pair in "${pairs[@]}"; do
  fnox_key="${pair%%:*}"
  worker_name="${pair##*:}"
  val=$(fnox get "$fnox_key" 2>/dev/null || true)
  if [ -z "$val" ]; then
    echo "ERROR: fnox has no value for '$fnox_key'." >&2
    echo "       Set it: fnox set --global -p keychain $fnox_key" >&2
    exit 1
  fi
  echo "→ wrangler secret put $worker_name  (from fnox:$fnox_key)"
  echo "$val" | wrangler secret put "$worker_name"
done
