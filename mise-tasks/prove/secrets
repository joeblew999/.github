#!/usr/bin/env bash
#MISE description="List secrets on the deployed Worker, assert all 4 expected names present (ACCOUNT_ID, API_KEY, TEAM_DOMAIN, POLICY_AUD)."
set -euo pipefail

# Companion to cf:secrets-put-mapped — those four secrets are what every
# d1-manager-style fork needs. If your fork uses different names, write
# its own per-fork prove:secrets.

out=$(wrangler secret list 2>&1)
echo "$out"
echo
for k in ACCOUNT_ID API_KEY TEAM_DOMAIN POLICY_AUD; do
  echo "$out" | grep -q "\"$k\"" \
    && echo "  ✓ $k present" \
    || { echo "  ✗ $k MISSING — run cf:secrets-put-mapped"; exit 1; }
done
