#!/usr/bin/env nu
#MISE description="tag and push a new semver release"
#USAGE arg "<tag>" help="semver tag to create, e.g. v0.3.0"

def main [tag?: string] {
  let t = ($tag | default ($env.usage_tag? | default ""))
  if ($t | is-empty) {
    print --stderr "✗ usage: mise run release -- vX.Y.Z"
    exit 1
  }
  if not ($t =~ '^v[0-9]+\.[0-9]+\.[0-9]+$') {
    print --stderr "✗ tag must be vX.Y.Z (e.g. v0.3.0)"
    exit 1
  }

  let branch = (^git rev-parse --abbrev-ref HEAD | str trim)
  if $branch != "main" {
    print --stderr $"✗ not on main \(currently on ($branch)\) — switch to main first"
    exit 1
  }

  let dirty_unstaged = (^git diff --quiet | complete | get exit_code)
  let dirty_staged = (^git diff --cached --quiet | complete | get exit_code)
  if $dirty_unstaged != 0 or $dirty_staged != 0 {
    print --stderr "✗ working tree is dirty — commit first"
    exit 1
  }

  let exists = (^git tag -l $t | str trim)
  if not ($exists | is-empty) {
    print --stderr $"✗ tag ($t) already exists"
    exit 1
  }

  ^git tag $t
  ^git push origin $t

  print $"✓ tagged ($t) and pushed"
  print ""
  print $"Consuming repos: bump ?ref=($t) in their mise.toml, then:"
  print "  mise cache clear && mise tasks ls"
}
