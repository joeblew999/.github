#!/usr/bin/env bash
#MISE description="show fnox secrets + current repo's GitHub Actions secrets"
set -euo pipefail

# Workaround for anthropics/claude-code#53833: IDE shells leak FNOX_AGE_KEY=undefined.
# Harmless once all secrets are on keychain provider, but leave in for safety.
unset FNOX_AGE_KEY

echo "== fnox =="
fnox list 2>/dev/null || echo "  (no config — run: mise run fnox:init)"

echo
# Parse origin URL rather than `gh repo view` — gh follows the parent on
# forks, which would show the wrong repo's secrets.
ORIGIN_URL=$(git remote get-url origin 2>/dev/null || true)
if [ -z "$ORIGIN_URL" ]; then
  echo "== GitHub repo secrets =="
  echo "  (not in a git repo with an origin remote)"
else
  REPO=$(printf '%s' "$ORIGIN_URL" | sed -E 's|.*[:/]([^/]+)/([^/.]+)(\.git)?$|\1/\2|')
  echo "== GitHub repo secrets ($REPO) =="
  gh secret list --repo "$REPO" 2>/dev/null || echo "  (gh secret list failed — run: gh auth login)"
fi
