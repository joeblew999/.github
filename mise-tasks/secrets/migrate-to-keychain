#!/usr/bin/env bash
#MISE description="move every age-encrypted secret in fnox global config → OS keychain"
set -euo pipefail

# Idempotent. Discovers age-provider entries dynamically, so any future secret
# added on age gets migrated next run. Non-age providers are left alone.
# After running, optionally enable Touch ID per item via Keychain Access.app →
# Access Control on each item under service=fnox (the keyring crate fnox uses
# can't set biometric ACLs at creation; manual GUI step).

# Defensive: anthropics/claude-code#53833 leaks FNOX_AGE_KEY=undefined into
# IDE shells. fnox prefers FNOX_AGE_KEY (inline value) over FNOX_AGE_KEY_FILE,
# so the leaked string makes parsing fail with "non-identity data on line 1".
unset FNOX_AGE_KEY

CONFIG="$HOME/.config/fnox/config.toml"

if [ ! -f "$CONFIG" ]; then
  echo "✗ no fnox config at $CONFIG — run: mise run fnox:init" >&2
  exit 1
fi

# Match both inline (keychain = { type = "keychain"... }) and table
# ([providers.keychain]) forms — `fnox provider add` writes the table form.
if ! grep -qE '^\[providers\.keychain\]|^keychain[[:space:]]*=' "$CONFIG"; then
  echo "→ adding keychain provider to global config"
  fnox provider add --global keychain keychain
else
  echo "✓ keychain provider already configured"
fi

# Extract every secret name currently using provider = "age".
# Format: `KEY= { provider = "age", value = "..." }` on a single line.
AGE_LIST=$(grep -E '^[A-Z_][A-Z0-9_]*=[[:space:]]*\{[[:space:]]*provider[[:space:]]*=[[:space:]]*"age"' "$CONFIG" | sed -E 's/^([A-Z_][A-Z0-9_]*)=.*/\1/' || true)

if [ -z "$AGE_LIST" ]; then
  echo "✓ no age-encrypted secrets remain — nothing to migrate"
  exit 0
fi

COUNT=$(printf '%s\n' "$AGE_LIST" | wc -l | tr -d ' ')
echo "→ migrating $COUNT secret(s) from age → keychain"
while IFS= read -r SECRET; do
  [ -z "$SECRET" ] && continue
  echo "→ $SECRET"
  VALUE="$(fnox get "$SECRET")"
  printf '%s' "$VALUE" | fnox set --global -p keychain "$SECRET"
  unset VALUE
done <<< "$AGE_LIST"

echo
echo "Done. Verify with: mise run secrets:sync-github-dry"
echo "If all secrets resolve, you can delete ~/.config/fnox/age.key and remove [providers.age] from $CONFIG"
