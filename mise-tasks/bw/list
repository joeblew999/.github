#!/usr/bin/env bash
#MISE description="List item names + sizes in your NodeWarden vault. Values are NOT shown."
set -euo pipefail

unset FNOX_AGE_KEY

BW_SESSION=$(fnox get BW_SESSION 2>/dev/null || true)
[ -z "$BW_SESSION" ] && { echo "✗ no BW_SESSION — run 'mise run bw:bootstrap'" >&2; exit 1; }
export BW_SESSION

if ! bw status 2>/dev/null | jq -e '.status == "unlocked"' >/dev/null; then
  echo "✗ vault locked — run 'mise run bw:unlock'" >&2
  exit 1
fi

bw list items 2>/dev/null \
  | jq -r '.[] | select(.type==1) | "  \(.name)\t\(.login.password // "" | length) bytes"' \
  | sort
