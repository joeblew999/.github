#!/usr/bin/env bash
#MISE description="resolve which config/<env>.env file to read; default `production`. Prints path. Hidden helper used by other shared tasks."
#MISE hide=true
set -euo pipefail

env_name="${MISE_ENV:-${ENV:-production}}"
file="config/${env_name}.env"
if [ ! -f "$file" ]; then
  echo "ERROR: $file not found." >&2
  echo "       cp config/template.env $file  and fill it in." >&2
  exit 1
fi
printf '%s' "$file"
